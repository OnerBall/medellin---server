# Скопируйте в .env для локального запуска. На Railway — раздел Variables.

# Токен бота от @BotFather
BOT_TOKEN=

# Ваш Telegram id (узнать: @userinfobot). Несколько админов — через запятую
ADMIN_CHAT_ID=

# WhatsApp для кнопок «Написать в WhatsApp»
WHATSAPP=77022585183

# Ссылка на канал (кнопка в профиле каталога)
CHANNEL_URL=

# Необязательно: брать товары только из этого канала (@username или -100…)
CHANNEL_ID=

# Упаковка по умолчанию, если в посте не указано «В упаковке: N шт»
PACK_DEFAULT=12

# Файл базы. На Railway подключите Volume в /data и укажите /data/medellin.db
DB_PATH=./data/medellin.db

# На Railway не нужно — домен подставится сам (RAILWAY_PUBLIC_DOMAIN)
WEBHOOK_URL=
PORT=3000
