# Скопируйте этот файл в .env для локального запуска.
# На Railway эти же переменные задаются в разделе Variables проекта.

# Токен бота от @BotFather (команда /newbot)
BOT_TOKEN=

# Ваш Telegram chat_id — куда бот шлёт уведомления о заказах.
# Узнать свой id: напишите боту @userinfobot, он пришлёт его в ответ.
ADMIN_CHAT_ID=

# Пароль для входа в «Вид администратора» в самом Mini App.
# Придумайте любой, не короче 8 символов.
ADMIN_SECRET=

# Публичный HTTPS-адрес вашего сервера — нужен ТОЛЬКО в проде,
# чтобы бот работал через webhook вместо long polling.
# На Railway это обычно https://<project>.up.railway.app
WEBHOOK_URL=

# Порт — на Railway подставляется автоматически, локально можно не трогать
PORT=3000

# Путь к файлу базы данных. Для Railway с подключённым Volume
# укажите путь внутри него, например /data/medellin.db
DB_PATH=./data/medellin.db
